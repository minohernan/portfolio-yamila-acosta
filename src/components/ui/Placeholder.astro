---
/** Marco visible SOLO en desarrollo para indicar dónde va una foto real. */
type Props = { label?: string; class?: string };
const { label = 'Foto pendiente', class: className } = Astro.props;
---

<div
  class:list={[
    'flex h-full w-full flex-col items-center justify-center gap-2 border-2 border-dashed border-sea-300 bg-[repeating-linear-gradient(45deg,var(--color-sand-50),var(--color-sand-50)_12px,var(--color-sand-100)_12px,var(--color-sand-100)_24px)] p-4 text-center',
    className,
  ]}
  role="img"
  aria-label={`Placeholder: ${label}`}
  data-placeholder
>
  <span class="rounded-full bg-sea-600 px-3 py-1 text-[0.65rem] font-bold tracking-widest text-white uppercase">Placeholder</span>
  <span class="text-sm font-medium text-deep-700">{label}</span>
</div>
