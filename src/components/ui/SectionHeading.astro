---
type Props = { eyebrow?: string; title: string; intro?: string; id?: string; align?: 'left' | 'center'; tone?: 'light' | 'dark' };
const { eyebrow, title, intro, id, align = 'left', tone = 'light' } = Astro.props;
const centered = align === 'center';
---

<header class:list={['reveal max-w-2xl', centered && 'mx-auto text-center']}>
  {eyebrow && <p class="eyebrow">{eyebrow}</p>}
  <h2
    id={id}
    class:list={['mt-3 text-3xl leading-tight sm:text-4xl lg:text-5xl', tone === 'dark' && 'text-white']}
  >
    {title}
  </h2>
  <span aria-hidden="true" class:list={['mt-5 block h-1 w-12 rounded-full bg-coral-500', centered && 'mx-auto']}></span>
  {intro && <p class:list={['mt-6 text-lg leading-relaxed', tone === 'dark' ? 'text-sea-50' : 'text-deep-700']}>{intro}</p>}
</header>
