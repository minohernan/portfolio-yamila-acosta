---
import { profile } from '../data/profile';
import { isPhotoVisible } from '../lib/paths';
import Photo from './ui/Photo.astro';
import SectionHeading from './ui/SectionHeading.astro';

const { sports, communication } = profile;
const sportPhotos = sports.photos.filter(isPhotoVisible);
const commPhotos = communication.photos.filter(isPhotoVisible);
---

<section id="mas-sobre-mi" aria-labelledby="lifestyle-title" class="section relative overflow-hidden bg-sand-100">
  <svg aria-hidden="true" class="absolute inset-x-0 top-0 h-10 w-full text-white sm:h-16" viewBox="0 0 1440 60" preserveAspectRatio="none">
    <path fill="currentColor" d="M0 0h1440v28c-120 18-240 26-360 18S840 16 720 16 480 40 360 44 120 36 0 24z"></path>
  </svg>

  <div class="container-page relative">
    <SectionHeading
      id="lifestyle-title"
      eyebrow="Más allá del derecho"
      title="Deporte, comunicación y energía para cada desafío"
      align="center"
    />

    <!-- Deporte -->
    <article aria-labelledby="sports-title" class:list={['mt-16 grid items-center gap-10 lg:gap-16', sportPhotos.length > 0 && 'lg:grid-cols-2']}>
      <div class="reveal">
        <p class="eyebrow">Deporte</p>
        <h3 id="sports-title" class="mt-3 text-3xl sm:text-4xl">{sports.intro}</h3>
        <p class="mt-5 leading-relaxed text-deep-700">{sports.closing}</p>
        <ul class="mt-6 flex flex-wrap gap-2" aria-label="Actividades deportivas">
          {sports.activities.map((a) => <li class="rounded-full bg-white px-4 py-1.5 text-sm font-medium text-deep-800 shadow-softer">{a}</li>)}
        </ul>
        <ul class="mt-8 grid grid-cols-2 gap-3" aria-label="Lo que me enseña el deporte">
          {
            sports.qualities.map((q) => (
              <li class="rounded-2xl border border-sea-300 bg-sea-50/60 px-4 py-3 font-serif text-lg text-sea-700">{q}</li>
            ))
          }
        </ul>
      </div>

      {
        sportPhotos.length > 0 && (
          <div class="reveal grid grid-cols-2 gap-3 sm:gap-4">
            {sportPhotos.map((photo, i) => (
              <div class:list={['overflow-hidden rounded-3xl shadow-soft', i === 0 ? 'col-span-2 aspect-[16/10]' : 'aspect-square']}>
                <Photo photo={photo} sizes="(min-width: 1024px) 40vw, 90vw" />
              </div>
            ))}
          </div>
        )
      }
    </article>

    <!-- Comunicación / producciones -->
    <article
      aria-labelledby="communication-title"
      class:list={['mt-24 grid items-center gap-10 lg:gap-16', commPhotos.length > 0 && 'lg:grid-cols-2']}
    >
      {
        commPhotos.length > 0 && (
          <div class="reveal order-2 grid grid-cols-2 gap-3 sm:gap-4 lg:order-1">
            {commPhotos.length === 1 ? (
              <div class="relative col-span-2 mx-auto w-full max-w-md">
                <div aria-hidden="true" class="absolute -right-4 -bottom-4 h-2/3 w-2/3 rounded-[2rem] bg-sea-200/60" />
                <div class="relative aspect-[4/5] overflow-hidden rounded-[2rem] shadow-soft">
                  <Photo photo={commPhotos[0]} sizes="(min-width: 1024px) 40vw, 90vw" />
                </div>
              </div>
            ) : (
              commPhotos.map((photo, i) => (
                <div class:list={['aspect-[3/4] overflow-hidden rounded-3xl shadow-soft', i % 2 === 1 && 'translate-y-8']}>
                  <Photo photo={photo} sizes="(min-width: 1024px) 25vw, 45vw" />
                </div>
              ))
            )}
          </div>
        )
      }
      <div class="reveal order-1 lg:order-2">
        <p class="eyebrow">Comunicación</p>
        <h3 id="communication-title" class="mt-3 text-3xl sm:text-4xl">{communication.intro}</h3>
        <p class="mt-5 leading-relaxed text-deep-700">{communication.closing}</p>
        <ul class="mt-8 grid grid-cols-2 gap-3" aria-label="Lo que aporta esta faceta">
          {
            communication.qualities.map((q) => (
              <li class="rounded-2xl border border-coral-400/50 bg-white/60 px-4 py-3 font-serif text-lg text-coral-700">{q}</li>
            ))
          }
        </ul>
      </div>
    </article>
  </div>
</section>
