---
import { profile } from '../data/profile';
import SectionHeading from './ui/SectionHeading.astro';

const { values } = profile;
---

<section aria-labelledby="values-title" class="section relative overflow-hidden bg-sand-50">
  <div aria-hidden="true" class="absolute -top-32 -right-32 h-80 w-80 rounded-full bg-sea-100/70 blur-3xl"></div>
  <div class="container-page relative">
    <SectionHeading id="values-title" eyebrow="Mi forma de trabajar" title="Valores que guían cada caso" intro={values.intro} />
    <ol class="mt-14 grid gap-x-10 gap-y-2 sm:grid-cols-2 lg:grid-cols-3">
      {
        values.items.map((v, i) => (
          <li class="reveal group border-t border-deep-900/10 py-7" style={`--delay:${(i % 3) * 90}ms`}>
            <span class="font-serif text-sm text-coral-700">{String(i + 1).padStart(2, '0')}</span>
            <h3 class="mt-2 text-2xl transition-colors group-hover:text-sea-700">{v.title}</h3>
            <p class="mt-3 leading-relaxed text-deep-700">{v.text}</p>
          </li>
        ))
      }
    </ol>
  </div>
</section>
