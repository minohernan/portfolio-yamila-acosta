---
import { profile } from '../data/profile';
import type { GalleryCategory } from '../types/profile';
import { isPhotoVisible } from '../lib/paths';
import Photo from './ui/Photo.astro';
import SectionHeading from './ui/SectionHeading.astro';

const labels: Record<GalleryCategory, string> = {
  profesional: 'Profesional',
  deporte: 'Deporte',
  producciones: 'Producciones',
  eventos: 'Eventos',
};

// En producción solo se muestran fotos reales; si no hay ninguna, la sección no se renderiza.
const items = profile.gallery.filter(isPhotoVisible);
const categories = (Object.keys(labels) as GalleryCategory[]).filter((c) => items.some((i) => i.category === c));
// Con pocas fotos se usa una fila uniforme; con más, el mosaico.
const compact = items.length <= 3;
---

{
  items.length > 0 && (
    <section id="galeria" aria-labelledby="gallery-title" class="section bg-sea-50/50">
      <div class="container-page">
        <SectionHeading id="gallery-title" eyebrow="Galería" title="Momentos" />

        {categories.length > 1 && (
          <div class="reveal mt-10 flex flex-wrap gap-2" role="group" aria-label="Filtrar galería por categoría">
            <button type="button" class="gallery-filter" data-filter="all" aria-pressed="true">
              Todas
            </button>
            {categories.map((c) => (
              <button type="button" class="gallery-filter" data-filter={c} aria-pressed="false">
                {labels[c]}
              </button>
            ))}
          </div>
        )}

        <ul
          class:list={['mt-10 grid gap-2 sm:gap-4', compact ? 'grid-cols-3' : 'grid-cols-2 md:grid-cols-3 lg:grid-cols-4']}
          id="gallery-grid"
        >
          {items.map((item, i) => (
            <li
              class:list={[
                'reveal overflow-hidden rounded-2xl shadow-softer',
                compact ? 'aspect-[3/4]' : i % 5 === 0 ? 'row-span-2 aspect-[3/4] h-full' : 'aspect-square',
              ]}
              style={`--delay:${(i % 4) * 90}ms`}
              data-category={item.category}
            >
              <Photo
                photo={item}
                sizes={compact ? '(min-width: 1152px) 370px, 33vw' : '(min-width: 1024px) 25vw, (min-width: 768px) 33vw, 50vw'}
                widths={[300, 600, 900]}
              />
            </li>
          ))}
        </ul>
      </div>
    </section>
  )
}

<style>
  .gallery-filter {
    border-radius: 9999px;
    padding: 0.5rem 1.1rem;
    font-size: 0.875rem;
    font-weight: 600;
    color: var(--color-deep-800);
    background: white;
    box-shadow: var(--shadow-softer);
    transition:
      background-color 0.2s,
      color 0.2s;
  }
  .gallery-filter:hover {
    color: var(--color-sea-700);
  }
  .gallery-filter[aria-pressed='true'] {
    background: var(--color-sea-700);
    color: white;
  }
</style>
