---
import { profile } from '../data/profile';
import SectionHeading from './ui/SectionHeading.astro';

const accents = ['bg-sea-400', 'bg-coral-400', 'bg-sea-600', 'bg-sand-200'];
---

<section id="especialidades" aria-labelledby="specialties-title" class="section">
  <div class="container-page">
    <SectionHeading id="specialties-title" eyebrow="Especialidades" title="Áreas de práctica" />
    <ul class="mt-14 grid gap-5 sm:grid-cols-2 lg:grid-cols-4">
      {
        profile.specialties.map((s, i) => (
          <li
            class="reveal card group relative flex flex-col overflow-hidden p-7 transition duration-300 hover:-translate-y-1.5 hover:shadow-[0_18px_40px_-16px_rgb(13_43_58/0.25)]"
            style={`--delay:${i * 90}ms`}
          >
            <span
              aria-hidden="true"
              class:list={[
                'mb-8 block h-12 w-12 rounded-2xl opacity-90 transition-transform duration-500 group-hover:scale-110',
                accents[i % accents.length],
              ]}
            />
            <h3 class="text-xl font-semibold">{s.title}</h3>
            <p class="mt-3 leading-relaxed text-deep-700">{s.text}</p>
          </li>
        ))
      }
    </ul>
  </div>
</section>
