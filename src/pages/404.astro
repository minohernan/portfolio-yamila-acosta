---
import BaseLayout from '../layouts/BaseLayout.astro';
import { profile } from '../data/profile';
---

<BaseLayout title={`Página no encontrada | ${profile.name}`} noindex>
  <main id="contenido" class="flex min-h-[100svh] items-center bg-gradient-to-b from-sea-50 to-sand-50">
    <div class="container-page text-center">
      <p class="eyebrow">Error 404</p>
      <h1 class="mt-3 text-4xl sm:text-5xl">Página no encontrada</h1>
      <p class="mt-5 text-deep-700">La página que buscás no existe o fue movida.</p>
      <a href={import.meta.env.BASE_URL} class="btn btn-primary mt-10">Volver al inicio</a>
    </div>
  </main>
</BaseLayout>
